# A real environment variable wins over this file.
# The mod is active by default; set EVEJS_AUTOPILOT_JUMP_ZERO=0 to keep vanilla
# EveJS behaviour (autopilot warps stop ~10 km short of the target).
EVEJS_AUTOPILOT_JUMP_ZERO=1

# Autopilot warp-in distance in meters, 0..1000000. Default: 0.
#   0    = land on the target: a stargate jump fires the moment the warp ends,
#          and a station destination docks on arrival.
#   2500 or less keeps gate landings inside the client's jump bubble.
#   above 2500 pushes gate landings back outside it and restores the slow
#   retail-style approach (retail sits around 15000).
# Manual, fleet, scan-result and mission warps carry their own range and are
# never affected.
EVEJS_AUTOPILOT_JUMP_ZERO_WARP_IN_METERS=0

# Logs seam and activation details. Default: 0.
EVEJS_AUTOPILOT_JUMP_ZERO_VERBOSE=0